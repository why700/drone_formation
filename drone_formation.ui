  </property>
  <property name="styleSheet">
   <string notr="true">/* === 1. 全局设置 === */
#MainFrame {
    /* 1. 设置背景底图 */ 
    /* 路径相对“本 .ui 文件所在目录(= 项目根目录)”，方便在 Qt Designer 里直接预览 */
    /* 运行时 main_gui.py 会自动把 url() 换成 assets/ 的绝对路径，见 _abs_asset_urls() */
    border-image: url(assets/drone_bg_transparent.png) 0 0 0 0 stretch stretch;

    /* 2. 只有这个容器有边框，去掉其他干扰 */
    border: none;
}
/* === 2. 分组框 (卡片化) === */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.6);       /* 卡片背景：白色，显眼 */
    border: 1px solid #dcdfe6;       /* 边框线：很淡的灰色 */
    border-radius: 8px;              /* 圆角：数值越大，角越圆 */
    
    /* === 关键布局参数 === */
    margin-top: 5
px;    /* 外部上间距：让这个框和上面的框拉开 20px 的距离（防止挨在一起） */
    padding-top: 2px;   /* 内部上留白：为了给标题留位置，防止内容被标题压住 */
    padding-bottom: 2px;/* 内部下留白 */
    padding-left: 10px;  /* 内部左留白 */
    padding-right: 10px; /* 内部右留白 */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;   /* 位置：左上角 */
    left: 15px;                      /* 距离左边的距离 */
    padding: 0 5px;                  /* 标题文字左右留点空隙 */
    color: #409EFF;                  /* 颜色：科技蓝 */
    font-weight: bold;               /* 加粗 */
    background-color: #f0f2f5;       /* 背景色：必须和窗口背景色一致，用来遮住边框线 */
	font-weight: bold;
}

/* === 3. 输入框 (撑开间距的核心) === */
QDoubleSpinBox, QSpinBox {
    border: 1px solid #dcdfe6;       /* 边框：淡灰 */
    border-radius: 4px;              /* 圆角 */
    padding: 0px 0px;                /* 内边距：文字离边框的距离 */
    background-color: #fff;          /* 背景白 */
    
    /* === 核心撑开参数 === */
    min-height: 8px;    /* 最小高度：强制让框框变高，不再是扁扁的 */
    margin: 2px;         /* 外部间距：强制在这个框的上下左右留出 6px 的“隔离带”，防止挨着别人 */
}

/* 鼠标悬停或者是选中时的效果 */
QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #409EFF;       /* 选中时变蓝 */
    background-color: #ecf5ff;       /* 选中时背景变淡蓝 */
}
QPushButton {
    border-radius: 4px;              /* 圆角 */
    padding: 5px 15px;               /* 内边距：把按钮撑大 */
    font-weight: bold;               /* 文字加粗 */
    color: white;                    /* 文字白色 */
    border: none;                    /* 去掉丑陋的默认边框 */
    
    /* === 核心撑开参数 === */
    min-height: 20px;    /* 最小高度：让按钮看起来大气 */
    margin: 3px;         /* 外部间距：同上，防止按钮挨在一起 */
}

/* === 5. 绿色按钮 (开始) === */
QPushButton[text^=&quot;开始&quot;], QPushButton[text^=&quot;▶&quot;] {
    background-color: #67C23A;       /* 绿色背景 */
}
QPushButton[text^=&quot;开始&quot;]:hover { 
    background-color: #85ce61;       /* 悬停变浅绿 */
}
QPushButton[text^=&quot;开始&quot;]:pressed { 
    background-color: #5daf34;       /* 按下变深绿 */
}

/* === 6. 蓝色按钮 (地图) - 新增了变色效果 === */
QPushButton[text^=&quot;地图&quot;] {
    background-color: #409EFF;       /* 基础蓝 */
}
/* 【新增】鼠标放上去变浅蓝 */
QPushButton[text^=&quot;地图&quot;]:hover { 
    background-color: #66b1ff;       
}
/* 【新增】鼠标按下去变深蓝 */
QPushButton[text^=&quot;地图&quot;]:pressed { 
    background-color: #3a8ee6;       
}
/* === 5. 标签微调 === */
QLabel {
    background: transparent;         /* 背景透明 */
    border: none;                    /* 无边框 */
    margin-right: 5px;               /* 右边距：让文字和后面的输入框拉开 5px 的距离 */
	font-weight: bold;
}</string>
